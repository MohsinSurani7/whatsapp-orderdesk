# Supabase (required on Netlify)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (Netlify subdomain after deploy)
NEXT_PUBLIC_APP_URL=https://your-site.netlify.app

# Session cookie signing (must be long + random)
SESSION_SECRET=change-this-long-random-string

# Local AI (no paid key needed)
AI_PROVIDER=local

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=my_whatsapp_verify_token_123
WHATSAPP_ACCESS_TOKEN=your-meta-permanent-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WABA_ID=your-waba-id

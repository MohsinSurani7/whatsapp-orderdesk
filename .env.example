# Supabase (required on Netlify)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (Netlify subdomain after deploy)
NEXT_PUBLIC_APP_URL=https://your-site.netlify.app

# Session cookie signing (must be long + random)
SESSION_SECRET=change-this-long-random-string

# Fast free AI (Groq Llama 8B). Get key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_free_groq_key
# GROQ_MODEL=llama-3.1-8b-instant

# Optional: Gemini Flash instead of Groq
# GEMINI_API_KEY=AIza...

AI_PROVIDER=groq

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_ACCESS_TOKEN=your-meta-permanent-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WABA_ID=your-waba-id

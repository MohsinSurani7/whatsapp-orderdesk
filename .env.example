# Supabase (required on Netlify)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (Netlify subdomain after deploy)
NEXT_PUBLIC_APP_URL=https://your-site.netlify.app

# Session cookie signing (must be long + random)
SESSION_SECRET=change-this-long-random-string

# Fast free AI (Groq). Get key: https://console.groq.com/keys
# Note: llama-3.1-8b-instant was retired Aug 2026 — use gpt-oss models
GROQ_API_KEY=gsk_your_free_groq_key
GROQ_MODEL=openai/gpt-oss-20b
# Fallback tried automatically: openai/gpt-oss-120b

# Optional: Gemini Flash instead of Groq
# GEMINI_API_KEY=AIza...

AI_PROVIDER=groq

# WhatsApp Cloud API (legacy single-shop fallback; per-business tokens live in dashboard)
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_ACCESS_TOKEN=your-meta-permanent-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WABA_ID=your-waba-id

# Encrypt WhatsApp/Groq secrets at rest (falls back to SESSION_SECRET)
TOKEN_ENCRYPTION_KEY=another-long-random-string

# Meta Embedded Signup (server-only — NEVER prefix with NEXT_PUBLIC_)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_EMBEDDED_SIGNUP_CONFIG_ID=your-embedded-signup-config-id
META_GRAPH_VERSION=v26.0
